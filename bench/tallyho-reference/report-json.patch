+def render_json(entries: list[Entry], month: str | None = None) -> str:
+    entries = entries_for_month(entries, month)
+    totals = calcualte_totals(entries)
+    grand = sum(totals.values(), Decimal("0"))
+    return json.dumps({
+        "month": month,
+        "count": len(entries),
+        "total": str(grand.quantize(CENT)),
+        "by_category": {c: str(a.quantize(CENT)) for c, a in totals.items()},
+    })
