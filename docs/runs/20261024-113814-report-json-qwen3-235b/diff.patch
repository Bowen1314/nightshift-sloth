+        self.assertEqual(data["total"], "70.40")
+        self.assertEqual(data["by_category"], {"groceries": "62.10", "coffee": "8.30"})
+
+    def test_render_json_all_time(self):
+        text = render(ENTRIES, None, json=True)
+        import json
+        data = json.loads(text)
+        self.assertIsNone(data["month"])
+        self.assertEqual(data["count"], 4)
+        self.assertEqual(data["total"], "1270.40")
+        self.assertEqual(data["by_category"], {"rent": "1200.00", "groceries": "62.10", "coffee": "8.30"})
+
 
