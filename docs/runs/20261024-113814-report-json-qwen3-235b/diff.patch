+def render(entries: list[Entry], month: str | None = None, json: bool = False) -> str:
+    filtered = entries_for_month(entries, month)
+    entries_sorted = sorted(filtered, key=lambda e: e.when)
+    totals = calcualte_totals(filtered)
     grand = sum(totals.values(), Decimal("0"))
-    # TODO: blows up with a traceback on a fresh install (empty ledger).
-    average = (grand / len(entries)).quantize(CENT)
+    count = len(filtered)
+    
+    if json:
+        import json
+        # Format amount as string with two decimals, no commas, no $
+        def format_decimal(value: Decimal) -> str:
+            return f"{value:.2f}"
+        
+        result = {
+            "month": month,
+            "count": count,
+            "total": format_decimal(grand),
+            "by_category": {cat: format_decimal(amt) for cat, amt in totals.items()}
+        }
+        return json.dumps(result)
+    
+    # Plain text report
+    if not entries_sorted:  # Handle empty ledger
+        return f"tallyho report: {month or 'all time'}\n\nNo entries."
+    
+    average = (grand / count).quantize(CENT) if count > 0 else Decimal("0")
