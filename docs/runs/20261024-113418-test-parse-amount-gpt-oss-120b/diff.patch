+class ParseAmountTest(unittest.TestCase):
+    """Tests for :func:`tally.money.parse_amount` covering various valid and
+    invalid inputs as specified in the chore description."""
+
+    def test_plain_amount(self):
+        self.assertEqual(parse_amount("4.50"), Decimal("4.50"))
+
+    def test_leading_dollar(self):
+        self.assertEqual(parse_amount("$4.50"), Decimal("4.50"))
+
+    def test_thousands_separator(self):
+        self.assertEqual(parse_amount("1,234.56"), Decimal("1234.56"))
+
+    def test_surrounding_whitespace(self):
+        self.assertEqual(parse_amount("  $  7.00  "), Decimal("7.00"))
+
+    def test_negative_refund(self):
+        self.assertEqual(parse_amount("-12.00"), Decimal("-12.00"))
+
+    def test_negative_with_dollar(self):
+        self.assertEqual(parse_amount("-$3"), Decimal("-3.00"))
+
+    def test_invalid_input_raises(self):
+        with self.assertRaises(ValueError):
+            parse_amount("not a number")
+
+
 if __name__ == "__main__":
     unittest.main()
