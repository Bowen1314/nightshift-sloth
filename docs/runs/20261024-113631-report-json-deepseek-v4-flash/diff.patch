+    def test_report_json_month(self):
+        self.run_cli("add", "4.50", "coffee", "--date", "2026-10-01")
+        code, text = self.run_cli("report", "--month", "2026-10", "--json")
+        self.assertEqual(code, 0)
+        self.assertEqual(json.loads(text)["month"], "2026-10")
