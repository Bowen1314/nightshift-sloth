diff --git a/tally/report.py b/tally/report.py
index f7ca91e..5cf5e7d 100644
--- a/tally/report.py
+++ b/tally/report.py
@@ -20,6 +20,20 @@ def calcualte_totals(entries: list[Entry]) -> dict[str, Decimal]:
     return dict(sorted(totals.items(), key=lambda kv: (-kv[1], kv[0])))
 
 
+def json_report(entries: list[Entry], month: str | None = None) -> dict:
+    """Machine-readable totals: amounts are strings with exactly two decimals."""
+    entries = entries_for_month(entries, month)
+    totals = calcualte_totals(entries)
+    grand = sum(totals.values(), Decimal("0"))
+    two_decimal = lambda amount: f"{amount:.2f}"  # noqa: E731
+    return {
+        "month": month,
+        "count": len(entries),
+        "total": two_decimal(grand),
+        "by_category": {category: two_decimal(amount) for category, amount in totals.items()},
+    }
+
+
 def render(entries: list[Entry], month: str | None = None) -> str:
     entries = sorted(entries_for_month(entries, month), key=lambda e: e.when)
     totals = calcualte_totals(entries)
