@@ -1,5 +1,6 @@
 """Monthly and all-time totals by category."""
 
+import json
 from decimal import Decimal
 
 from .ledger import Entry
@@ -20,6 +21,24 @@ def calcualte_totals(entries: list[Entry]) -> dict[str, Decimal]:
     return dict(sorted(totals.items(), key=lambda kv: (-kv[1], kv[0])))
 
 
+def render_json(entries: list[Entry], month: str | None = None) -> str:
+    filtered = entries_for_month(entries, month)
+    totals = calcualte_totals(filtered)
+    grand = sum(totals.values(), Decimal("0"))
+    data = {
+        "month": month,
+        "count": len(filtered),
+        "total": _amount_string(grand),
+        "by_category": {category: _amount_string(amount) for category, amount in totals.items()},
+    }
+    return json.dumps(data)
+
+
+def _amount_string(value: Decimal) -> str:
+    rounded = value.quantize(CENT)
+    return "0.00" if rounded == 0 else format(rounded, "f")
+
+
 def render(entries: list[Entry], month: str | None = None) -> str:
     entries = sorted(entries_for_month(entries, month), key=lambda e: e.when)
     totals = calcualte_totals(entries)
