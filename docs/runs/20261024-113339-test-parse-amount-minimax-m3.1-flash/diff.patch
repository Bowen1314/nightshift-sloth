+    def test_surrounding_whitespace(self):
+        self.assertEqual(parse_amount("  $1,234.56  "), Decimal("1234.56"))
+
+    def test_negative_refunds(self):
+        self.assertEqual(parse_amount("-12.00"), Decimal("-12.00"))
