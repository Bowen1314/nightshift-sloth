+    def test_leading_dollar_sign(self):
+        self.assertEqual(parse_amount("$4.50"), Decimal("4.50"))
+
+    def test_thousands_separator(self):
+        self.assertEqual(parse_amount("1,234.56"), Decimal("1234.56"))
