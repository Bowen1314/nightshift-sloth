@@ -0,0 +1,18 @@
+import unittest
+
+from tally.report import render
+
+
+class ReportEmptyTest(unittest.TestCase):
+    def test_render_no_entries(self):
+        # When there are no entries at all, the report should be a short
+        # message instead of raising an exception.
+        self.assertEqual(render([], None), "No entries yet.")
+
+    def test_render_no_entries_month(self):
+        # The same behaviour applies when a month filter yields no results.
+        self.assertEqual(render([], "2026-10"), "No entries yet.")
+
+
+if __name__ == "__main__":
+    unittest.main()
