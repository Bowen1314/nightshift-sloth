+    def test_add_uses_aware_utc_timestamp(self):
+        entry = ledger.add(Decimal("1"), "x", path=self.path)
+        self.assertEqual(entry.when.tzinfo, timezone.utc)
+        self.assertEqual(ledger.load(self.path)[0].when.tzinfo, timezone.utc)
+
+    def test_load_preserves_legacy_naive_timestamp(self):
+        self.path.write_text(
+            '[{"when":"2026-09-01T08:15:00","amount":"1","category":"x","note":""}]'
+        )
+        entry = ledger.load(self.path)[0]
+        self.assertEqual(entry.when, datetime(2026, 9, 1, 8, 15))
+        self.assertEqual(
+            ledger.as_utc(entry.when),
+            datetime(2026, 9, 1, 8, 15, tzinfo=timezone.utc),
+        )
+
+    def test_recent_sorts_mixed_naive_and_aware_timestamps(self):
+        self.path.write_text(
+            '[{"when":"2026-09-01T08:15:00","amount":"1","category":"old","note":""},'
+            '{"when":"2026-10-24T12:00:00+00:00","amount":"2","category":"new","note":""}]'
+        )
+        entries = ledger.recent(ledger.load(self.path))
+        self.assertEqual([e.category for e in entries], ["new", "old"])
+
 
 if __name__ == "__main__":
     unittest.main()
